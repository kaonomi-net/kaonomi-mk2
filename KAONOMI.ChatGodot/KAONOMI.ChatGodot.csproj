<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KAONOMI.ChatGodot</RootNamespace>
  </PropertyGroup>

  <!-- Shared/: the models, view models and services of the chat (settings of config.yml, the Kaonomi server, Ollama,
       Piper (text to speech), the activity log; namespaces KAONOMI.Chat.*), and the 3D animations (Shared/Views/SceneShaders.cs,
       their shaders translated to Godot by SceneShaderTranslator). They came from the Avalonia chat KAONOMI.Chat, removed
       since; the SDK compiles them with the other sources. -->

  <!-- The face images of the 3D animations and the music helpers (Assets/Audio), next to the assembly. -->
  <ItemGroup>
    <None Include="Assets\*-face.png;Assets\hal-eye.png;Assets\Audio\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The logo of the YouTube channel Le Lab IA, in the banner of the login screen. -->
    <None Include="Assets\lelabia-avatar.jpg;Assets\jerome-head.png;Assets\jerome-cover.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- The pictures of the Ghost, CounterStrike, Defense, Minecraft, Mars, Couture, Silicon, Robotics, Aquarium, Kaonomi-Dark and Kaonomi-White themes, drawn by their shaders (Palette.Stamp). -->
    <None Include="Assets\ghost-rooftop.jpg;Assets\cs-match.jpg;Assets\defense-field.jpg;Assets\minecraft-valley.jpg;Assets\mars-curiosity.jpg;Assets\couture-sketches.jpg;Assets\silicon-die.jpg;Assets\robotics-lab.jpg;Assets\aquarium-tank.jpg;Assets\kaonomi-net.jpg" CopyToOutputDirectory="PreserveNewest" />
    <!-- The bodies of the animations, drawn from their faces (Tools/avatar-body/generate_bodies.py): the walker reads them. -->
    <None Include="Assets\*-body.png;Assets\*-body.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The scenes of /pedago: a picture and the outlines of its objects. -->
    <None Include="Assets\pedago\*.jpg;Assets\pedago\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The configuration (config.yml and config.json), next to the assembly. -->
  <ItemGroup>
    <None Include="config.yml;config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="TextMateSharp" Version="2.0.0" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="2.0.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
    <PackageReference Include="Markdig" Version="0.40.0" />
  </ItemGroup>
</Project>
